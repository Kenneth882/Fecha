# Copy to .env. Never commit .env.
# These placeholders are enough for `docker compose up` on your machine. Replace
# JWT_SECRET (and the Postgres password) before running anywhere else.

# Signs access tokens. Required, at least 32 characters. Generate a real one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-dev-only-jwt-secret-replace-me-0123456789

# How long an access token from /auth/login lasts. Optional; there are no refresh tokens.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Credentials for the postgres service in docker-compose.yml. If you change them,
# change DATABASE_URL and TEST_DATABASE_URL below to match.
POSTGRES_USER=cramplan
POSTGRES_PASSWORD=cramplan
POSTGRES_DB=cramplan

# For running the API, worker and tests on the host. In `docker compose up`, the
# api and worker containers get their own URLs (postgres:5432, redis:6379) instead.
DATABASE_URL=postgresql+asyncpg://cramplan:cramplan@localhost:5432/cramplan
TEST_DATABASE_URL=postgresql+asyncpg://cramplan:cramplan@localhost:5432/cramplan_test
REDIS_URL=redis://localhost:6379/0

# Level for the JSON logs: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
