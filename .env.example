# Copy to .env and fill in. Never commit .env.

# Signs access tokens. Required, at least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Local services from docker-compose.yml (docker compose up -d postgres redis).
DATABASE_URL=postgresql+asyncpg://cramplan:cramplan@localhost:5432/cramplan
TEST_DATABASE_URL=postgresql+asyncpg://cramplan:cramplan@localhost:5432/cramplan_test
REDIS_URL=redis://localhost:6379/0
