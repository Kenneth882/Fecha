            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array",
            "title": "Details"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "details",
          "request_id"
        ],
        "title": "ErrorBody"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "description": "One specific problem, such as a field that failed validation."
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "description": "The body of every 4xx and 5xx response."
      },
      "EventCreate": {
        "properties": {
          "type": {
            "$ref": "#/components/schemas/EventType"
          },
          "target_language": {
            "type": "string",
            "const": "es",
            "title": "Target Language"
          },
          "event_day": {
            "type": "string",
            "format": "date",
            "title": "Event Day"
          },
          "level": {
            "$ref": "#/components/schemas/Level"
          },
          "daily_budget": {
            "type": "integer",
            "enum": [
              15,
              30,
              45
            ],
            "title": "Daily Budget"
          },
          "goals": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Goals"
          }
        },
        "type": "object",
        "required": [
          "type",
          "target_language",
          "event_day",
          "level",
          "daily_budget"
        ],
        "title": "EventCreate",
        "description": "What a User sends to create an Event. The Event Day must be 3 to 60 days after\ntheir local today, which the Event service checks."
      },
      "EventDetail": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "type": {
            "$ref": "#/components/schemas/EventType"
          },
          "target_language": {
            "type": "string",
            "const": "es",
            "title": "Target Language"
          },
          "event_day": {
            "type": "string",
            "format": "date",
            "title": "Event Day"
          },
          "abandoned_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abandoned At"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "state": {
            "$ref": "#/components/schemas/EventState"
          },
          "days_until_event_day": {
            "type": "integer",
            "title": "Days Until Event Day"
          },
          "level": {
            "$ref": "#/components/schemas/Level"
          },
          "daily_budget": {
            "type": "integer",
            "enum": [
              15,
              30,
              45
            ],
            "title": "Daily Budget"
          },
          "goals": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Goals"
          },
          "current_plan_version": {
            "type": "integer",
            "title": "Current Plan Version"
          }
        },
        "type": "object",
        "required": [
          "id",
          "type",
          "target_language",
          "event_day",
          "abandoned_at",
          "created_at",
          "state",
          "days_until_event_day",
          "level",
          "daily_budget",
