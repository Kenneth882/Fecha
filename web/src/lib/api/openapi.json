              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events/{event_id}/abandon": {
      "post": {
        "tags": [
          "events"
        ],
        "summary": "Abandon",
        "description": "Abandon the User's Active Event so they can create another. It stays readable.",
        "operationId": "events-abandon",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
